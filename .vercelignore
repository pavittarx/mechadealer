uv.lock

# Hide the workspace root from Vercel's Python builder: it prefers `uv lock`
# when a root pyproject.toml exists, which fails because tool.uv.sources
# references members this deployment deliberately excludes. Leading slash so
# the member manifests under libs/ and projects/ are still uploaded.
/pyproject.toml
.venv/
