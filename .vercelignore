# The API function only needs storelib and app_server (see requirements.txt).
# Everything else is either the frontend, local infrastructure, or unused by
# the deployed function.
app/
containers/
docs/
tests/
.github/
libs/brokerlib/
libs/coreutils/
libs/datastore/
libs/kafkalib/
libs/strategylib/
projects/datasync/
projects/orders_management/
