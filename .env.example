# Copy to .env and fill in. Values below match the local docker-compose stack.
#   cp .env.example .env

# --- QuestDB (time-series market data) -------------------------------------
# Reads go over PGWire, writes go over ILP via questdb's Sender.from_env().
QDB_CONNECTION_STRING=postgresql://admin:quest@localhost:8812/qdb
QDB_CLIENT_CONF=http::addr=localhost:9000;

# --- Postgres (users, strategies, orders) ----------------------------------
PG_CONNECTION_STRING=postgresql://test:1235789@localhost:5432/pgdb

# --- Kafka -----------------------------------------------------------------
KAFKA_BROKER_ADDRESS=localhost:9092

# --- app_server ------------------------------------------------------------
# Required. Generate one with: openssl rand -hex 32
JWT_SECRET=
# Comma-separated list of allowed frontend origins.
CORS_ORIGINS=http://localhost:3000

# --- Upstox broker ---------------------------------------------------------
# Required by brokerlib (orders_management, stats_handler, strategy_0).
# Create an app at https://account.upstox.com/developer/apps with redirect URI
# http://localhost:8900/callback
UPSTOX_CLIENT_ID=
UPSTOX_CLIENT_SECRET=

# --- Runtime state ---------------------------------------------------------
# Where encrypted broker credentials and log files are written.
# Defaults to ~/.mechadealer when unset.
# MECHADEALER_HOME=/var/lib/mechadealer
